---
// Custom Header component for MyFormCapture documentation portal
// Preserves the existing website header appearance, logo, navigation links, and Start Free Trial CTA
---

<div class="mfc-header-container">
  <div class="mfc-header-inner">
    <!-- Brand Logo -->
    <a href="/" class="mfc-brand" aria-label="MyFormCapture Documentation Home">
      <div class="mfc-brand-icon">
        <img src="/favicon.png" alt="MyFormCapture Logo" width="28" height="28" class="mfc-brand-img" />
      </div>
      <div class="mfc-brand-text">
        <span class="mfc-brand-name">MyFormCapture</span>
      </div>
      <span class="mfc-docs-badge">Docs</span>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="mfc-nav" aria-label="Main Navigation">
      <a href="#features" class="mfc-nav-link">Features</a>
      <a href="#pricing" class="mfc-nav-link">Pricing</a>
      <a href="/" class="mfc-nav-link active">Resources</a>
    </nav>

    <!-- Right Side Actions: Sign In + Start Free Trial CTA -->
    <div class="mfc-actions">
      <a href="#signin" class="mfc-nav-link mfc-signin-link">Sign In</a>
      <a href="#trial" class="mfc-trial-btn">Start Free Trial</a>

      <!-- Mobile Menu Toggle Button -->
      <button type="button" class="mfc-mobile-toggle" id="mfcMobileToggle" aria-label="Toggle Navigation Menu" aria-expanded="false">
        <svg class="mfc-icon-menu" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg class="mfc-icon-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      <!-- Starlight Docs Sidebar Toggle for Mobile -->
      <button popovertarget="starlight__sidebar" class="mfc-sidebar-toggle" aria-label="Toggle Documentation Sidebar">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="9" y1="3" x2="9" y2="21"></line>
        </svg>
        <span>Docs Menu</span>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div class="mfc-mobile-drawer" id="mfcMobileDrawer">
    <a href="#features" class="mfc-mobile-link">Features</a>
    <a href="#pricing" class="mfc-mobile-link">Pricing</a>
    <a href="/" class="mfc-mobile-link active">Resources & Docs</a>
    <div class="mfc-mobile-divider"></div>
    <a href="#signin" class="mfc-mobile-link">Sign In</a>
    <a href="#trial" class="mfc-trial-btn mfc-mobile-cta">Start Free Trial</a>
  </div>
</div>

<script>
  // Simple vanilla JS for the website mobile header toggle
  const toggleBtn = document.getElementById('mfcMobileToggle');
  const drawer = document.getElementById('mfcMobileDrawer');

  if (toggleBtn && drawer) {
    toggleBtn.addEventListener('click', () => {
      const isOpen = drawer.classList.toggle('is-open');
      toggleBtn.setAttribute('aria-expanded', String(isOpen));
      const iconMenu = toggleBtn.querySelector('.mfc-icon-menu') as HTMLElement;
      const iconClose = toggleBtn.querySelector('.mfc-icon-close') as HTMLElement;
      if (iconMenu && iconClose) {
        iconMenu.style.display = isOpen ? 'none' : 'block';
        iconClose.style.display = isOpen ? 'block' : 'none';
      }
    });
  }
</script>

<style>
  /* Scoped styles for the existing website header */
  .mfc-header-container {
    width: 100%;
    height: 100%;
    position: relative;
    background: #ffffff;
    font-family: 'Inter var', 'Inter', ui-sans-serif, system-ui, sans-serif,
      'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol', 'Noto Color Emoji';
  }

  .mfc-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  /* Logo */
  .mfc-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: inherit;
    user-select: none;
    flex-shrink: 0;
  }

  .mfc-brand-icon {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mfc-brand-img {
    width: 28px;
    height: 28px;
    border-radius: 6px;
    object-fit: contain;
    display: block;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.08);
  }

  .mfc-brand-text {
    display: flex;
    align-items: baseline;
  }

  .mfc-brand-name {
    font-size: clamp(1.2rem, 1.15rem + 0.25vw, 1.35rem);
    font-weight: 700;
    color: #0f172a;
    letter-spacing: -0.025em;
  }

  .mfc-docs-badge {
    font-size: 0.775rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.55rem;
    border-radius: 9999px;
    background-color: #eff6ff;
    color: #2563eb;
    border: 1px solid #bfdbfe;
    margin-left: 0.35rem;
  }

  /* Desktop Nav */
  .mfc-nav {
    display: none;
    align-items: center;
    gap: 2.25rem;
  }

  @media (min-width: 768px) {
    .mfc-nav {
      display: flex;
    }
  }

  .mfc-nav-link {
    font-size: clamp(1rem, 0.95rem + 0.2vw, 1.075rem);
    font-weight: 500;
    color: #475569;
    text-decoration: none;
    transition: color 0.15s ease;
    padding: 0.45rem 0;
    position: relative;
  }

  .mfc-nav-link:hover {
    color: #0f172a;
  }

  .mfc-nav-link.active {
    color: #2563eb;
    font-weight: 600;
  }

  .mfc-nav-link.active::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    right: 0;
    height: 2px;
    background-color: #2563eb;
    border-radius: 2px;
  }

  /* Right actions */
  .mfc-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .mfc-signin-link {
    display: none;
    font-size: clamp(0.975rem, 0.95rem + 0.15vw, 1.025rem);
  }

  @media (min-width: 640px) {
    .mfc-signin-link {
      display: inline-block;
    }
  }

  .mfc-trial-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #2563eb;
    color: #ffffff;
    font-size: clamp(0.95rem, 0.925rem + 0.15vw, 1.025rem);
    font-weight: 600;
    padding: 0.6rem 1.35rem;
    border-radius: 0.5rem;
    text-decoration: none;
    transition: background-color 0.15s ease, box-shadow 0.15s ease, transform 0.1s ease;
    box-shadow: 0 1px 2px rgba(37, 99, 235, 0.2);
    white-space: nowrap;
  }

  .mfc-trial-btn:hover {
    background-color: #1d4ed8;
    box-shadow: 0 3px 8px rgba(37, 99, 235, 0.3);
  }

  /* Sidebar Toggle for Docs on Mobile */
  .mfc-sidebar-toggle {
    display: none;
    align-items: center;
    gap: 0.35rem;
    background: #f1f5f9;
    color: #334155;
    border: 1px solid #cbd5e1;
    border-radius: 0.375rem;
    padding: 0.45rem 0.75rem;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
  }

  @media (max-width: 799px) {
    .mfc-sidebar-toggle {
      display: inline-flex;
    }
  }

  /* Mobile toggle */
  .mfc-mobile-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: 1px solid #e2e8f0;
    border-radius: 0.375rem;
    padding: 0.5rem;
    color: #475569;
    cursor: pointer;
  }

  @media (min-width: 768px) {
    .mfc-mobile-toggle {
      display: none;
    }
  }

  /* Mobile Drawer */
  .mfc-mobile-drawer {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: #ffffff;
    border-bottom: 1px solid #e2e8f0;
    padding: 1.25rem 1.5rem 1.75rem;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05);
    flex-direction: column;
    gap: 0.875rem;
  }

  .mfc-mobile-drawer.is-open {
    display: flex;
  }

  .mfc-mobile-link {
    font-size: 1.05rem;
    font-weight: 500;
    color: #334155;
    text-decoration: none;
    padding: 0.5rem 0;
  }

  .mfc-mobile-link.active {
    color: #2563eb;
    font-weight: 600;
  }

  .mfc-mobile-divider {
    height: 1px;
    background: #e2e8f0;
    margin: 0.35rem 0;
  }

  .mfc-mobile-cta {
    text-align: center;
    padding: 0.75rem 1.25rem;
    margin-top: 0.35rem;
    font-size: 1rem;
  }
</style>
