---
// ExplorePlatform.astro — "Explore the platform" section placed after Popular Integrations
// Displays 8 platform feature cards in a 2x4 grid with 1:1 aspect ratio, matching the StartBuilding design

interface ExploreCard {
  id: string;
  title: string;
  description: string;
  colorTheme: string;
  badge?: string;
  href: string;
}

const exploreCards: ExploreCard[] = [
  {
    id: 'domain-config',
    title: 'Domain Configuration',
    description: 'Set authorized domains, restrict origins, and prevent unauthorized submissions.',
    colorTheme: 'blue',
    badge: 'NEW',
    href: '/guides/domain-configuration/',
  },
  {
    id: 'form-config',
    title: 'Form Configuration',
    description: 'Manage redirect URLs, custom success pages, and webhook triggers.',
    colorTheme: 'cyan',
    href: '/guides/form-configuration/',
  },
  {
    id: 'loader-js',
    title: 'Loader.js',
    description: 'Lightweight JS library for ajax submit, validation, and dynamic form loading.',
    colorTheme: 'amber',
    badge: 'NEW',
    href: '/guides/loader-js/',
  },
  {
    id: 'booking-widget',
    title: 'Booking Widget',
    description: 'Add scheduling, appointments, and booking workflows directly to your forms.',
    colorTheme: 'purple',
    href: '/guides/booking-widget/',
  },
  {
    id: 'file-uploads',
    title: 'File Uploads',
    description: 'Collect documents, images, and attachments securely with cloud storage integration.',
    colorTheme: 'emerald',
    href: '/guides/file-uploads/',
  },
  {
    id: 'choice-matrices',
    title: 'Tables & Choice Matrices',
    description: 'Structure complex survey data, multi-option rankings, and matrix inputs.',
    colorTheme: 'indigo',
    href: '/guides/choice-matrices/',
  },
  {
    id: 'spam-captcha',
    title: 'Spam & CAPTCHA',
    description: 'Honeypot fields, rate limiting, reCAPTCHA, and Cloudflare Turnstile protection.',
    colorTheme: 'green',
    href: '/guides/spam-captcha/',
  },
  {
    id: 'autoresponder',
    title: 'Autoresponder Emails',
    description: 'Send instant confirmation emails, branded receipts, and custom notifications.',
    colorTheme: 'orange',
    href: '/guides/autoresponder-emails/',
  },
];
---

<section class="mfc-explore-platform not-content" id="explore-the-platform">
  <div class="mfc-explore-inner">
    {/* Section Header */}
    <div class="mfc-explore-header">
      <h2 class="mfc-explore-title">Explore the platform</h2>
      <p class="mfc-explore-subtitle">
        Go beyond basic forms with advanced submission features, built-in spam protection, and AI operations.
      </p>
    </div>

    {/* 8 Cards Grid in 2 Rows (4 Columns per row) */}
    <div class="mfc-explore-grid">
      {exploreCards.map((card) => (
        <a
          href={card.href}
          class="mfc-explore-card is-link"
          data-feature={card.id}
        >
          {card.badge && (
            <span class="mfc-card-badge" aria-label={`Badge: ${card.badge}`}>
              {card.badge}
            </span>
          )}

          <div class={`mfc-card-top-row ${card.badge ? 'has-badge' : ''}`}>
            <div class={`mfc-card-icon-box box-${card.colorTheme}`} aria-hidden="true">
              {card.id === 'domain-config' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10" />
                  <line x1="2" y1="12" x2="22" y2="12" />
                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                </svg>
              )}

              {card.id === 'form-config' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="4" y1="21" x2="4" y2="14" />
                  <line x1="4" y1="10" x2="4" y2="3" />
                  <line x1="12" y1="21" x2="12" y2="12" />
                  <line x1="12" y1="8" x2="12" y2="3" />
                  <line x1="20" y1="21" x2="20" y2="16" />
                  <line x1="20" y1="12" x2="20" y2="3" />
                  <line x1="1" y1="14" x2="7" y2="14" />
                  <line x1="9" y1="8" x2="15" y2="8" />
                  <line x1="17" y1="16" x2="23" y2="16" />
                </svg>
              )}

              {card.id === 'loader-js' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                  <polyline points="14 2 14 8 20 8" />
                  <text x="11.5" y="17.5" fill="currentColor" stroke="none" font-size="7.5" font-family="system-ui, -apple-system, sans-serif" font-weight="800" text-anchor="middle">JS</text>
                </svg>
              )}

              {card.id === 'booking-widget' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                  <line x1="16" y1="2" x2="16" y2="6" />
                  <line x1="8" y1="2" x2="8" y2="6" />
                  <line x1="3" y1="10" x2="21" y2="10" />
                  <polyline points="9 16 11 18 15 14" />
                </svg>
              )}

              {card.id === 'file-uploads' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                  <polyline points="17 8 12 3 7 8" />
                  <line x1="12" y1="3" x2="12" y2="15" />
                </svg>
              )}

              {card.id === 'choice-matrices' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="3" width="18" height="18" rx="2" />
                  <line x1="3" y1="9" x2="21" y2="9" />
                  <line x1="3" y1="15" x2="21" y2="15" />
                  <line x1="9" y1="3" x2="9" y2="21" />
                  <line x1="15" y1="3" x2="15" y2="21" />
                </svg>
              )}

              {card.id === 'spam-captcha' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                  <path d="M12 2L4 5v6.09c0 5.05 3.41 9.76 8 10.91 4.59-1.15 8-5.86 8-10.91V5l-8-3z" fill="#10b981" />
                  <polyline points="9 12 11 14 15 10" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}

              {card.id === 'autoresponder' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                  <polyline points="22,6 12,13 2,6" />
                </svg>
              )}
            </div>
            <h3 class="mfc-card-heading">{card.title}</h3>
          </div>

          <p class="mfc-card-desc">{card.description}</p>

          <div class="mfc-card-footer">
            <span class="mfc-card-link-text">Read Guide</span>
            <span class="mfc-card-arrow" aria-hidden="true">&rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  /* ==========================================================================
     Explore the Platform Section
     Placed immediately after Popular Integrations
     ========================================================================== */

  .mfc-explore-platform {
    width: 100%;
    padding: 0.85rem 2rem 0.85rem;
    box-sizing: border-box;
    background-color: #ffffff;
  }

  .mfc-explore-inner {
    max-width: 86rem;
    margin: 0 auto;
  }

  /* --------------------------------------------------------------------------
     Header: Title & Subtitle (Documentation Scale)
     -------------------------------------------------------------------------- */
  .mfc-explore-header {
    margin-bottom: 1.15rem;
  }

  .mfc-explore-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: #0f172a;
    letter-spacing: -0.025em;
    margin: 0 0 0.35rem;
    line-height: 1.25;
  }

  .mfc-explore-subtitle {
    font-size: 0.875rem;
    color: #64748b;
    margin: 0;
    line-height: 1.45;
  }

  /* --------------------------------------------------------------------------
     Cards Grid: 4 Column x 2 Row Layout
     -------------------------------------------------------------------------- */
  .mfc-explore-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.15rem;
    width: 100%;
  }

  /* --------------------------------------------------------------------------
     1:1 Ratio Card Design (Matching StartBuilding)
     -------------------------------------------------------------------------- */
  .mfc-explore-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
    aspect-ratio: 1 / 1;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 1.2rem 1.1rem 1rem;
    box-sizing: border-box;
    text-decoration: none !important;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    overflow: hidden;
    cursor: pointer;
  }

  .mfc-explore-card:hover {
    border-color: #93c5fd;
    box-shadow:
      0 10px 24px -4px rgba(37, 99, 235, 0.09),
      0 2px 6px -1px rgba(15, 23, 42, 0.04);
    transform: translateY(-2px);
  }

  /* --------------------------------------------------------------------------
     Top Badge (NEW)
     -------------------------------------------------------------------------- */
  .mfc-card-badge {
    position: absolute;
    top: 0.95rem;
    right: 0.95rem;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    background: #f1f5f9;
    color: #475569;
    border: 1px solid #e2e8f0;
    text-transform: uppercase;
    line-height: 1.2;
    z-index: 1;
  }

  /* --------------------------------------------------------------------------
     Card Header Row (Icon Container + Title)
     -------------------------------------------------------------------------- */
  .mfc-card-top-row {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin: 0;
    margin-bottom: 0.6rem;
  }

  .mfc-card-top-row.has-badge {
    padding-right: 2.5rem;
  }

  .mfc-card-icon-box {
    width: 38px;
    height: 38px;
    min-width: 38px;
    border-radius: 9px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.15s ease, border-color 0.15s ease;
  }

  .mfc-explore-card:hover .mfc-card-icon-box {
    transform: scale(1.08);
  }

  /* Color Variations */
  .box-blue {
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    color: #2563eb;
  }
  .box-cyan {
    background: #ecfeff;
    border: 1px solid #a5f3fc;
    color: #0891b2;
  }
  .box-amber {
    background: #fffbeb;
    border: 1px solid #fde68a;
    color: #d97706;
  }
  .box-purple {
    background: #faf5ff;
    border: 1px solid #e9d5ff;
    color: #9333ea;
  }
  .box-emerald {
    background: #ecfdf5;
    border: 1px solid #a7f3d0;
    color: #059669;
  }
  .box-indigo {
    background: #eef2ff;
    border: 1px solid #c7d2fe;
    color: #4f46e5;
  }
  .box-green {
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    color: #16a34a;
  }
  .box-orange {
    background: #fff7ed;
    border: 1px solid #fed7aa;
    color: #ea580c;
  }

  /* Hover Enhancements */
  .mfc-explore-card:hover .box-blue { background: #dbeafe; border-color: #93c5fd; }
  .mfc-explore-card:hover .box-cyan { background: #cffafe; border-color: #67e8f9; }
  .mfc-explore-card:hover .box-amber { background: #fef3c7; border-color: #fcd34d; }
  .mfc-explore-card:hover .box-purple { background: #f3e8ff; border-color: #d8b4fe; }
  .mfc-explore-card:hover .box-emerald { background: #d1fae5; border-color: #6ee7b7; }
  .mfc-explore-card:hover .box-indigo { background: #e0e7ff; border-color: #a5b4fc; }
  .mfc-explore-card:hover .box-green { background: #dcfce7; border-color: #86efac; }
  .mfc-explore-card:hover .box-orange { background: #ffedd5; border-color: #fdba74; }

  .mfc-card-heading {
    font-size: 0.875rem;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.25;
    margin: 0 !important;
    letter-spacing: -0.015em;
  }

  /* --------------------------------------------------------------------------
     Card Description
     -------------------------------------------------------------------------- */
  .mfc-card-desc {
    font-size: 0.78rem;
    color: #475569;
    line-height: 1.45;
    margin: 0;
    flex-grow: 1;
  }

  /* --------------------------------------------------------------------------
     Card Footer (Read Guide Link)
     -------------------------------------------------------------------------- */
  .mfc-card-footer {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: #2563eb;
    margin-top: auto;
    padding-top: 0.45rem;
    transition: gap 0.15s ease;
  }

  .mfc-explore-card:hover .mfc-card-footer {
    gap: 0.45rem;
  }

  .mfc-card-arrow {
    transition: transform 0.15s ease;
    font-size: 0.85rem;
    line-height: 1;
  }

  .mfc-explore-card:hover .mfc-card-arrow {
    transform: translateX(2px);
  }

  /* --------------------------------------------------------------------------
     Responsive Breakpoints
     -------------------------------------------------------------------------- */
  @media (max-width: 1100px) {
    .mfc-explore-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }
  }

  @media (max-width: 640px) {
    .mfc-explore-platform {
      padding: 0.85rem 1.25rem 1rem;
    }

    .mfc-explore-title {
      font-size: 1.25rem;
    }

    .mfc-explore-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem;
    }

    .mfc-explore-card {
      padding: 1rem 0.85rem 0.85rem;
    }

    .mfc-card-icon-box {
      width: 32px;
      height: 32px;
      min-width: 32px;
    }

    .mfc-card-heading {
      font-size: 0.85rem;
    }

    .mfc-card-desc {
      font-size: 0.75rem;
      line-height: 1.35;
    }

    .mfc-card-footer {
      font-size: 0.75rem;
    }
  }

  @media (max-width: 440px) {
    .mfc-explore-grid {
      grid-template-columns: 1fr;
    }

    .mfc-explore-card {
      aspect-ratio: 1.25 / 1;
      padding: 1.15rem;
    }

    .mfc-card-heading {
      font-size: 0.925rem;
    }

    .mfc-card-desc {
      font-size: 0.8rem;
    }
  }
</style>
