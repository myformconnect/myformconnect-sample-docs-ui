---
// HomeHero.astro — Hero section for MyFormCapture Documentation Homepage
// Precision pixel-matched to mfc-design.png
import Icon from './Icon.astro';
---

<div class="mfc-home-hero not-content">
  <div class="mfc-hero-inner">
    {/* Left Column: Messaging & CTAs */}
    <div class="mfc-hero-copy">
      <div class="mfc-eyebrow-badge">
        <svg class="mfc-eyebrow-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
          <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
        </svg>
        <span>DOCUMENTATION & GUIDES</span>
      </div>

      <h1 class="mfc-hero-main-title">
        Turn Any Form into<br />
        <span class="mfc-hero-highlight">Actionable Leads</span>
      </h1>

      <p class="mfc-hero-lead-desc">
        Integrate forms, capture submissions, and automate workflows across your favorite platforms — without building a backend.
      </p>

      <div class="mfc-hero-cta-group">
        <a href="/guides/html-form/" class="mfc-btn mfc-btn-primary">
          <span>Get Started Now</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <a href="#popular-integrations" class="mfc-btn mfc-btn-secondary">
          <span>Browse Integrations</span>
        </a>
      </div>

      <div class="mfc-hero-benefits">
        <div class="mfc-benefit-item">
          <span class="mfc-benefit-icon">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </span>
          <span class="mfc-benefit-text">No backend required</span>
        </div>
        <div class="mfc-benefit-item">
          <span class="mfc-benefit-icon">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </span>
          <span class="mfc-benefit-text">Spam protection included</span>
        </div>
        <div class="mfc-benefit-item">
          <span class="mfc-benefit-icon">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </span>
          <span class="mfc-benefit-text">Works with 50+ platforms</span>
        </div>
      </div>
    </div>

    {/* Right Column: Visual Workflow Illustration Canvas (Larger & Prominent) */}
    <div class="mfc-hero-visual" aria-hidden="true" id="mfcHeroVisual">
      <div class="mfc-visual-scaler" id="mfcVisualScaler">
        <div class="mfc-visual-canvas" id="mfcVisualCanvas">

          {/* SVG Dotted Connectors & Directional Arrows Overlay */}
          <svg class="mfc-connectors-overlay" viewBox="0 0 830 430" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <marker id="arrow-blue" viewBox="0 0 8 8" refX="6" refY="4" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                <path d="M 1 1 L 7 4 L 1 7" fill="none" stroke="#3b82f6" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </marker>
            </defs>

            {/* Newsletter form bottom -> MFC Hub left */}
            <path d="M 95 300 C 95 350, 115 375, 175 375" stroke="#60a5fa" stroke-width="1.8" stroke-dasharray="4 4" fill="none" marker-end="url(#arrow-blue)" />

            {/* Contact Us form bottom <-> MFC Hub top */}
            <path d="M 250 305 V 338" stroke="#60a5fa" stroke-width="1.8" stroke-dasharray="4 4" fill="none" marker-end="url(#arrow-blue)" />

            {/* Book a Meeting form bottom -> MFC Hub right */}
            <path d="M 415 305 C 415 350, 395 375, 335 375" stroke="#60a5fa" stroke-width="1.8" stroke-dasharray="4 4" fill="none" marker-end="url(#arrow-blue)" />

            {/* Outgoing arrows to 4 Workflow Cards on the right */}
            {/* Branch 1 -> Card 1: Send to Slack & Email */}
            <path d="M 480 115 C 515 115, 530 44, 578 44" stroke="#60a5fa" stroke-width="1.8" stroke-dasharray="4 4" fill="none" marker-end="url(#arrow-blue)" />

            {/* Branch 2 -> Card 2: AI Lead Summary */}
            <path d="M 490 175 C 525 175, 535 125, 578 125" stroke="#60a5fa" stroke-width="1.8" stroke-dasharray="4 4" fill="none" marker-end="url(#arrow-blue)" />

            {/* Branch 3 -> Card 3: Send to Webhooks */}
            <path d="M 495 220 C 530 220, 540 206, 578 206" stroke="#60a5fa" stroke-width="1.8" stroke-dasharray="4 4" fill="none" marker-end="url(#arrow-blue)" />

            {/* Branch 4 -> Card 4: Add to CRM */}
            <path d="M 480 285 C 515 285, 535 287, 578 287" stroke="#60a5fa" stroke-width="1.8" stroke-dasharray="4 4" fill="none" marker-end="url(#arrow-blue)" />
          </svg>

          {/* Form 1: Newsletter Signup (Left / Tilted -8deg) */}
          <div class="mfc-card-panel panel-newsletter">
            <div class="mfc-panel-header">
              <div class="mfc-panel-badge-icon blue-tint">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="#2563eb">
                  <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
                </svg>
              </div>
              <span class="mfc-panel-title">Newsletter Signup</span>
            </div>
            <div class="mfc-mock-input">Your name</div>
            <div class="mfc-mock-input">Your email</div>
            <button type="button" class="mfc-mock-btn">Subscribe</button>
          </div>

          {/* Form 2: Contact Us (Center / Foreground, Taller, Elevated) */}
          <div class="mfc-card-panel panel-contact">
            <div class="mfc-window-dots">
              <span class="dot dot-red"></span>
              <span class="dot dot-yellow"></span>
              <span class="dot dot-green"></span>
            </div>
            <div class="mfc-panel-header">
              <div class="mfc-panel-badge-icon blue-solid">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="#ffffff">
                  <path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"/>
                </svg>
              </div>
              <span class="mfc-panel-title">Contact Us</span>
            </div>
            <div class="mfc-mock-input">Name</div>
            <div class="mfc-mock-input">Email</div>
            <div class="mfc-mock-input input-textarea">Message</div>
            <button type="button" class="mfc-mock-btn">Send Message</button>
          </div>

          {/* Form 3: Book a Meeting (Right of forms / Tilted +6deg) */}
          <div class="mfc-card-panel panel-booking">
            <div class="mfc-panel-header">
              <div class="mfc-panel-badge-icon blue-solid">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                  <line x1="16" y1="2" x2="16" y2="6"/>
                  <line x1="8" y1="2" x2="8" y2="6"/>
                  <line x1="3" y1="10" x2="21" y2="10"/>
                </svg>
              </div>
              <div class="mfc-panel-heading-stack">
                <span class="mfc-panel-title">Book a Meeting</span>
                <span class="mfc-panel-sub">Select a date and time</span>
              </div>
            </div>

            {/* Calendar widget mockup */}
            <div class="mfc-mini-calendar">
              <div class="mfc-cal-weekdays">
                <span>Su</span><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span>
              </div>
              <div class="mfc-cal-grid">
                <span class="mfc-cal-day">3</span>
                <span class="mfc-cal-day">8</span>
                <span class="mfc-cal-day">7</span>
                <span class="mfc-cal-day">9</span>
                <span class="mfc-cal-day">7</span>
                <span class="mfc-cal-day">5</span>
                <span class="mfc-cal-day">8</span>

                <span class="mfc-cal-day">13</span>
                <span class="mfc-cal-day">8</span>
                <span class="mfc-cal-day">13</span>
                <span class="mfc-cal-day active">14</span>
                <span class="mfc-cal-day">13</span>
                <span class="mfc-cal-day">13</span>
                <span class="mfc-cal-day">18</span>

                <span class="mfc-cal-day">13</span>
                <span class="mfc-cal-day">14</span>
                <span class="mfc-cal-day">18</span>
                <span class="mfc-cal-day">23</span>
                <span class="mfc-cal-day">29</span>
                <span class="mfc-cal-day">23</span>
                <span class="mfc-cal-day">28</span>

                <span class="mfc-cal-day">28</span>
                <span class="mfc-cal-day">28</span>
                <span class="mfc-cal-day">23</span>
                <span class="mfc-cal-day">28</span>
                <span class="mfc-cal-day">28</span>
                <span class="mfc-cal-day">30</span>
                <span class="mfc-cal-day">27</span>
              </div>
            </div>

            <button type="button" class="mfc-mock-btn">Book Meeting</button>
          </div>

          {/* Center Bottom: MyFormCapture Identity Hub */}
          <div class="mfc-identity-hub">
            <div class="mfc-hub-badge">
              <img src="/favicon.png" alt="MyFormCapture Logo" width="28" height="28" class="mfc-hub-logo-img" />
            </div>
            <div class="mfc-hub-text">
              <span class="mfc-hub-name">MyFormCapture</span>
              <span class="mfc-hub-tagline">Collect &bull; Process &bull; Enrich &bull; Automate</span>
            </div>
          </div>

          {/* Downstream Output Cards (Column of 4 on the far right) */}
          <div class="mfc-workflow-stack">
            {/* Card 1: Send to Slack & Email (Slack logo + Gmail red M) */}
            <div class="mfc-workflow-card">
              <div class="mfc-dual-icon-wrap">
                <div class="mfc-icon-sub">
                  <Icon name="slack" width="19" height="19" />
                </div>
                <div class="mfc-icon-sub">
                  <svg width="19" height="19" viewBox="0 0 24 24" fill="none">
                    <path d="M4 6v12h3V10.5l5 3.5 5-3.5V18h3V6l-8 5.6L4 6z" fill="#ea4335" />
                  </svg>
                </div>
              </div>
              <div class="mfc-workflow-info">
                <span class="mfc-workflow-title">Send to Slack &amp; Email</span>
                <span class="mfc-workflow-sub">Get notified instantly</span>
              </div>
            </div>

            {/* Card 2: AI Lead Summary */}
            <div class="mfc-workflow-card">
              <div class="mfc-workflow-icon-wrap bg-blue-tint">
                <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <line x1="16" y1="13" x2="8" y2="13"></line>
                  <line x1="16" y1="17" x2="8" y2="17"></line>
                  <line x1="10" y1="9" x2="8" y2="9"></line>
                </svg>
              </div>
              <div class="mfc-workflow-info">
                <span class="mfc-workflow-title">AI Lead Summary</span>
                <span class="mfc-workflow-sub">Intent and next steps</span>
              </div>
            </div>

            {/* Card 3: Send to Webhooks */}
            <div class="mfc-workflow-card">
              <div class="mfc-workflow-icon-wrap bg-red-tint">
                <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="5" r="2.3" fill="#ef4444" />
                  <circle cx="5" cy="18" r="2.3" fill="#ef4444" />
                  <circle cx="19" cy="18" r="2.3" fill="#ef4444" />
                  <line x1="10.5" y1="6.8" x2="6.5" y2="16" />
                  <line x1="13.5" y1="6.8" x2="17.5" y2="16" />
                  <line x1="7.5" y1="18" x2="16.5" y2="18" />
                </svg>
              </div>
              <div class="mfc-workflow-info">
                <span class="mfc-workflow-title">Send to Webhooks</span>
                <span class="mfc-workflow-sub">Trigger automated workflows</span>
              </div>
            </div>

            {/* Card 4: Add to CRM */}
            <div class="mfc-workflow-card">
              <div class="mfc-workflow-icon-wrap bg-blue-tint">
                <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                  <ellipse cx="12" cy="5" rx="8" ry="3"></ellipse>
                  <path d="M4 5v6c0 1.66 3.58 3 8 3s8-1.34 8-3V5"></path>
                  <path d="M4 11v6c0 1.66 3.58 3 8 3s8-1.34 8-3v-6"></path>
                </svg>
              </div>
              <div class="mfc-workflow-info">
                <span class="mfc-workflow-title">Add to CRM</span>
                <span class="mfc-workflow-sub">Sync with your tools</span>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  function updateHeroVisualScale() {
    const visual = document.getElementById('mfcHeroVisual');
    const scaler = document.getElementById('mfcVisualScaler');
    const canvas = document.getElementById('mfcVisualCanvas');
    if (!visual || !scaler || !canvas) return;

    const availableWidth = visual.clientWidth;
    const baseWidth = 830;
    const baseHeight = 430;

    // Dynamically scales up to 1.05x on spacious screens or scales down smoothly on compact viewports
    const scale = Math.min(1.05, availableWidth / baseWidth);
    canvas.style.transform = `scale(${scale})`;
    canvas.style.transformOrigin = 'left top';

    scaler.style.width = `${baseWidth * scale}px`;
    scaler.style.height = `${baseHeight * scale}px`;
  }

  window.addEventListener('resize', updateHeroVisualScale, { passive: true });
  window.addEventListener('DOMContentLoaded', updateHeroVisualScale);
  updateHeroVisualScale();
</script>

<style>
  /* ==========================================================================
     HomeHero Component Styles
     Precision Pixel Matched to reference
     ========================================================================== */

  .mfc-home-hero {
    width: 100%;
    background: 
      radial-gradient(ellipse 65% 75% at 75% 15%, rgba(191, 219, 254, 0.42) 0%, rgba(224, 242, 254, 0.2) 35%, rgba(248, 250, 252, 0) 70%),
      radial-gradient(ellipse 40% 50% at 20% 20%, rgba(239, 246, 255, 0.6) 0%, rgba(248, 250, 252, 0) 60%),
      linear-gradient(180deg, #f0f7ff 0%, #f7faff 45%, #ffffff 100%);
    border-bottom: 1px solid #e2e8f0;
    padding: 3rem 2.25rem 1.75rem;
    box-sizing: border-box;
    overflow: hidden;
  }

  .mfc-hero-inner {
    max-width: 96rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.55fr);
    gap: 2.25rem;
    align-items: center;
  }

  /* --------------------------------------------------------------------------
     Left Column: Messaging
     -------------------------------------------------------------------------- */
  .mfc-hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    max-width: 36rem;
  }

  .mfc-eyebrow-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.26rem 0.8rem;
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    border-radius: 9999px;
    font-size: 0.725rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: #2563eb;
    margin-bottom: 1.15rem;
    box-shadow: 0 1px 2px rgba(37, 99, 235, 0.06);
  }

  .mfc-eyebrow-icon {
    color: #2563eb;
  }

  .mfc-hero-main-title {
    font-size: clamp(2.4rem, 2.05rem + 1.35vw, 3.25rem);
    font-weight: 800;
    color: #0f172a;
    line-height: 1.15;
    letter-spacing: -0.035em;
    margin: 0 0 1.15rem 0;
  }

  .mfc-hero-highlight {
    color: #2563eb;
    display: inline-block;
  }

  .mfc-hero-lead-desc {
    font-size: clamp(0.95rem, 0.92rem + 0.15vw, 1.05rem);
    color: #475569;
    line-height: 1.6;
    margin: 0 0 1.6rem 0;
    max-width: 33rem;
  }

  /* Compact CTA Buttons (Slightly Smaller as Requested) */
  .mfc-hero-cta-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.6rem;
  }

  .mfc-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.55rem 1.15rem;
    font-size: 0.85rem;
    font-weight: 600;
    border-radius: 0.45rem;
    text-decoration: none !important;
    transition: all 0.15s ease-in-out;
    cursor: pointer;
    line-height: 1.25;
  }

  .mfc-btn-primary {
    background-color: #2563eb;
    color: #ffffff !important;
    border: 1px solid #2563eb;
    box-shadow: 0 2px 4px rgba(37, 99, 235, 0.2), 0 1px 2px rgba(37, 99, 235, 0.1);
  }

  .mfc-btn-primary:hover {
    background-color: #1d4ed8;
    border-color: #1d4ed8;
    transform: translateY(-1px);
    box-shadow: 0 4px 8px rgba(37, 99, 235, 0.25);
  }

  .mfc-btn-secondary {
    background-color: #ffffff;
    color: #2563eb !important;
    border: 1.5px solid #2563eb;
  }

  .mfc-btn-secondary:hover {
    background-color: #eff6ff;
    transform: translateY(-1px);
  }

  /* Benefit Indicators */
  .mfc-hero-benefits {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
  }

  .mfc-benefit-item {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.825rem;
    font-weight: 500;
    color: #475569;
  }

  .mfc-benefit-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    border-radius: 9999px;
    background-color: #10b981;
    color: #ffffff;
    flex-shrink: 0;
  }

  /* --------------------------------------------------------------------------
     Right Column: Visual Workflow Illustration Canvas (Larger & Prominent)
     -------------------------------------------------------------------------- */
  .mfc-hero-visual {
    width: 100%;
    position: relative;
    display: flex;
    justify-content: flex-start;
    align-items: center;
  }

  .mfc-visual-scaler {
    position: relative;
    width: 830px;
    height: 430px;
    display: flex;
    justify-content: flex-start;
    align-items: flex-start;
  }

  .mfc-visual-canvas {
    position: relative;
    width: 830px;
    height: 430px;
    flex-shrink: 0;
  }

  /* SVG Connectors Overlay */
  .mfc-connectors-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  /* Base Form Panel Styling */
  .mfc-card-panel {
    position: absolute;
    background: #ffffff;
    border-radius: 12px;
    border: 1px solid #e2e8f0;
    padding: 1rem 1.05rem;
    box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.08), 0 4px 6px -2px rgba(15, 23, 42, 0.03);
    box-sizing: border-box;
    transition: transform 0.2s ease;
  }

  .mfc-panel-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.75rem;
  }

  .mfc-panel-badge-icon {
    width: 25px;
    height: 25px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .mfc-panel-badge-icon.blue-solid {
    background-color: #2563eb;
  }

  .mfc-panel-badge-icon.blue-tint {
    background-color: #eff6ff;
  }

  .mfc-panel-heading-stack {
    display: flex;
    flex-direction: column;
  }

  .mfc-panel-title {
    font-size: 0.85rem;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.2;
  }

  .mfc-panel-sub {
    font-size: 0.68rem;
    color: #64748b;
    line-height: 1.2;
  }

  /* Mock Input Fields */
  .mfc-mock-input {
    width: 100%;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 0.42rem 0.68rem;
    font-size: 0.74rem;
    color: #94a3b8;
    margin-bottom: 0.5rem;
    box-sizing: border-box;
  }

  .mfc-mock-input.input-textarea {
    height: 50px;
  }

  /* Mock Action Buttons */
  .mfc-mock-btn {
    width: 100%;
    background: #2563eb;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 0.46rem 0.75rem;
    font-size: 0.78rem;
    font-weight: 600;
    cursor: default;
    box-sizing: border-box;
  }

  /* Form 1: Newsletter (Left / Tilted -8deg) */
  .panel-newsletter {
    width: 195px;
    left: 10px;
    top: 62px;
    transform: rotate(-8deg);
    z-index: 1;
    border-color: #e2e8f0;
  }

  /* Form 2: Contact Us (Center / Foreground, Taller, Elevated) */
  .panel-contact {
    width: 232px;
    left: 145px;
    top: 15px;
    z-index: 3;
    padding-top: 0.7rem;
    box-shadow: 
      0 20px 35px -8px rgba(15, 23, 42, 0.12),
      0 8px 16px -4px rgba(15, 23, 42, 0.06),
      0 0 0 1px #cbd5e1;
  }

  /* macOS window dots */
  .mfc-window-dots {
    display: flex;
    align-items: center;
    gap: 5.5px;
    margin-bottom: 0.55rem;
    padding-bottom: 0.45rem;
    border-bottom: 1px solid #f1f5f9;
