---
import { Code } from "astro:components";

interface Props {
  language?: string;
  filename?: string;
  code: string;
}

const { language = "html", filename, code } = Astro.props;

// Map custom language names if needed
const langMap: Record<string, any> = {
  html: "html",
  jsx: "jsx",
  tsx: "tsx",
  javascript: "javascript",
  js: "javascript",
  json: "json",
  bash: "bash",
  css: "css",
};

const resolvedLang = langMap[language.toLowerCase()] || language || "html";
const id = "code-" + Math.random().toString(36).substring(2, 9);
---

<div class="mfc-code-block" id={id}>
  <div class="mfc-code-header">
    <!-- Clean filename without enclosed boxes or badges -->
    <div class="mfc-code-title">
      <span class="mfc-clean-filename"
        >{filename || language.toUpperCase()}</span
      >
    </div>

    <!-- Solid, non-breaking Copy Button -->
    <button
      type="button"
      class="mfc-copy-btn"
      aria-label="Copy code to clipboard"
    >
      <span class="mfc-btn-icon" aria-hidden="true">
        <svg
          class="icon-copy"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
          ></path>
        </svg>
        <svg
          class="icon-check"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </span>
      <span class="copy-text">Copy code</span>
    </button>
  </div>

  <!-- Raw text stored for reliable clipboard copy -->
  <textarea class="mfc-raw-code" style="display: none;" aria-hidden="true"
    >{code.trim()}</textarea
  >

  <!-- Shiki-highlighted syntax tree with VS Code theme -->
  <div class="mfc-code-content">
    <Code code={code.trim()} lang={resolvedLang} theme="github-dark" />
  </div>
</div>

<script>
  // Vanilla JavaScript for working Copy Code buttons with clipboard API
  document.querySelectorAll(".mfc-code-block").forEach((block) => {
    const btn = block.querySelector(".mfc-copy-btn");
    const rawTextarea = block.querySelector(
      ".mfc-raw-code",
    ) as HTMLTextAreaElement;
    const pre = block.querySelector("pre");
    const textSpan = block.querySelector(".copy-text");

    if (btn && textSpan) {
      btn.addEventListener("click", async () => {
        const textToCopy = rawTextarea
          ? rawTextarea.value
          : pre?.textContent || "";
        try {
          if (navigator.clipboard && window.isSecureContext) {
            await navigator.clipboard.writeText(textToCopy);
          } else {
            const textarea = document.createElement("textarea");
            textarea.value = textToCopy;
            textarea.style.position = "fixed";
            textarea.style.left = "-9999px";
            document.body.appendChild(textarea);
            textarea.select();
            document.execCommand("copy");
            document.body.removeChild(textarea);
          }

          // Visual feedback
          btn.classList.add("copied");
          textSpan.textContent = "Copied!";

          setTimeout(() => {
            btn.classList.remove("copied");
            textSpan.textContent = "Copy code";
          }, 2000);
        } catch (err) {
          console.error("Failed to copy code:", err);
          textSpan.textContent = "Failed";
          setTimeout(() => {
            textSpan.textContent = "Copy code";
          }, 2000);
        }
      });
    }
  });
</script>

<style>
  .mfc-code-block {
    background: #0d1117;
    border: 1px solid #30363d;
    border-radius: 0.625rem;
    overflow: hidden;
    margin: 1.5rem 0;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.08);
  }

  .mfc-code-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 1rem;
    background: #161b22;
    border-bottom: 1px solid #30363d;
    min-height: 2.75rem;
    box-sizing: border-box;
  }

  /* Clean filename without any boxed border or background */
  .mfc-code-title {
    display: flex;
    align-items: center;
  }

  .mfc-clean-filename {
    font-size: 0.85rem;
    font-weight: 500;
    color: #8b949e;
    font-family: var(--mfc-font-mono);
    letter-spacing: 0.01em;
    user-select: none;
  }

  /* Robust Copy Button that does not break or jump on click */
  .mfc-copy-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 0;
    gap: 0.4rem;
    width: 6.5rem; /* Fixed width prevents any layout break between 'Copy code' and 'Copied!' */
    height: 1.95rem;
    padding: 0 0.5rem;
    box-sizing: border-box;
    background: #21262d;
    color: #c9d1d9;
    border: 1px solid #30363d;
    border-radius: 0.375rem;
    font-size: 0.775rem;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
    user-select: none;
    transition:
      background 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease;
  }

  .mfc-copy-btn:hover {
    background: #30363d;
    color: #f0f6fc;
    border-color: #8b949e;
  }

  .mfc-copy-btn.copied {
    background: rgba(35, 134, 54, 0.2);
    color: #3fb950;
    border-color: rgba(63, 185, 80, 0.6);
  }

  .mfc-btn-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  .icon-copy,
  .icon-check {
    display: block;
    width: 14px;
    height: 14px;
  }

  /* Seamless icon toggle without layout shift */
  .icon-check {
    display: none;
    stroke: #3fb950;
  }

  .mfc-copy-btn.copied .icon-copy {
    display: none;
  }

  .mfc-copy-btn.copied .icon-check {
    display: block;
  }

  .copy-text {
    line-height: 1;
  }

  /* Shiki Code Block Styles */
  .mfc-code-content {
    margin-top: 0;
    background: #0d1117;
  }

  .mfc-code-content :global(pre.astro-code) {
    margin: 0 !important;
    padding: 1.15rem 1.25rem !important;
    background-color: #0d1117 !important;
    color: #e6edf3 !important;
    font-family: var(--mfc-font-mono) !important;
    font-size: 0.885rem !important;
    line-height: 1.65 !important;
    max-height: 28rem !important;
    overflow-x: auto !important;
    overflow-y: auto !important;
    scrollbar-width: thin;
    scrollbar-color: #30363d #161b22;
  }

  /* Sleek modern scrollbars for dark code block */
  .mfc-code-content :global(pre.astro-code::-webkit-scrollbar) {
    width: 8px;
    height: 8px;
  }

  .mfc-code-content :global(pre.astro-code::-webkit-scrollbar-track) {
    background: #161b22;
    border-radius: 0 0 0.625rem 0;
  }

  .mfc-code-content :global(pre.astro-code::-webkit-scrollbar-thumb) {
    background: #30363d;
    border-radius: 4px;
    border: 2px solid #161b22;
  }

  .mfc-code-content :global(pre.astro-code::-webkit-scrollbar-thumb:hover) {
    background: #484f58;
  }

  .mfc-code-content :global(pre code) {
    background: transparent !important;
    padding: 0 !important;
    font-family: inherit !important;
  }
</style>
