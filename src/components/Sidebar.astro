---
// Custom Starlight Sidebar Component
// Features: Lucide-style SVG icons for categories & items, collapsible groups with smooth chevrons,
// active page indicator, and seamless Starlight integration.
import MobileMenuFooter from '@astrojs/starlight/components/MobileMenuFooter.astro';

const { sidebar } = Astro.locals.starlightRoute;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

function isItemActive(href: string, label?: string) {
  if (!href) return false;
  // Anchor links, hashes, and placeholders should never receive active page status
  if (href.includes('#') || href.startsWith('#') || href === 'javascript:void(0)') {
    return false;
  }
  const cleanHref = href.replace(/\/$/, '') || '/';
  if (cleanHref === '/') {
    // Only 'Overview' is active on root '/'
    return currentPath === '/' && (label ? label.toLowerCase() === 'overview' : true);
  }
  return currentPath === cleanHref || currentPath === `${cleanHref}/`;
}

function hasActiveChild(entry: any): boolean {
  if (entry.type === 'link') {
    return isItemActive(entry.href, entry.label);
  }
  if (entry.entries && Array.isArray(entry.entries)) {
    return entry.entries.some((child: any) => hasActiveChild(child));
  }
  return false;
}
---

<script is:inline>
  (() => {
    try {
      if (window.innerWidth >= 800 && localStorage.getItem('mfc-sidebar-collapsed') === 'true') {
        document.documentElement.setAttribute('data-sidebar-collapsed', 'true');
      }
    } catch {}
  })();
</script>

<div class="mfc-custom-sidebar">
  <!-- Mobile search bar -->
  <div class="mfc-sidebar-mobile-search-section">
    <button
      type="button"
      class="mfc-sidebar-mobile-search-btn"
      id="mfcSidebarMobileSearchTrigger"
      aria-label="Search documentation, integrations, guides, and features"
      title="Search documentation (/)"
    >
      <svg
        class="mfc-mobile-search-icon"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <span class="mfc-mobile-search-placeholder"
        >Search documentation, guides, features...</span
      >
      <kbd class="mfc-mobile-search-kbd" aria-hidden="true">/</kbd>
    </button>
  </div>

  <!-- Desktop sidebar toggle -->
  <div class="mfc-sidebar-desktop-header">
    <span class="mfc-sidebar-desktop-tag">MENU</span>
    <button
      type="button"
      class="mfc-sidebar-collapse-btn"
      id="mfcSidebarCollapseToggle"
      aria-label="Collapse sidebar"
      title="Collapse sidebar"
    >
      <!-- Collapse icon -->
      <svg
        class="mfc-collapse-icon is-close"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect width="18" height="18" x="3" y="3" rx="2"></rect>
        <path d="M9 3v18"></path>
        <path d="m16 15-3-3 3-3"></path>
      </svg>
      <!-- Expand icon -->
      <svg
        class="mfc-collapse-icon is-open"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        style="display: none;"
      >
        <rect width="18" height="18" x="3" y="3" rx="2"></rect>
        <path d="M9 3v18"></path>
        <path d="m14 9 3 3-3 3"></path>
      </svg>
    </button>
  </div>

  <nav class="mfc-sidebar-nav" aria-label="Documentation Sidebar">
    {sidebar.map((group: any) => {
      const isGroup = group.type === 'group';
      const isExpanded = hasActiveChild(group) || !group.collapsed;
      const groupLabel = group.label || '';

      return isGroup ? (
        <details class="mfc-sidebar-group" open={isExpanded}>
          <summary class="mfc-group-summary">
            <span class="mfc-group-title-wrap">
              {/* Category Icons */}
              {groupLabel === 'Getting Started' && (
                <svg class="mfc-cat-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z" />
                  <path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z" />
                  <path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0" />
                  <path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5" />
                </svg>
              )}
              {groupLabel === 'Features' && (
                <svg class="mfc-cat-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="3" width="7" height="7" rx="1.5" />
                  <rect x="14" y="3" width="7" height="7" rx="1.5" />
                  <rect x="14" y="14" width="7" height="7" rx="1.5" />
                  <rect x="3" y="14" width="7" height="7" rx="1.5" />
                </svg>
              )}
              {groupLabel === 'Integrations' && (
                <svg class="mfc-cat-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="3" width="6" height="6" rx="1" />
                  <rect x="15" y="3" width="6" height="6" rx="1" />
                  <rect x="9" y="15" width="6" height="6" rx="1" />
                  <path d="M6 9v3a3 3 0 0 0 3 3h3" />
                  <path d="M18 9v3a3 3 0 0 1-3 3" />
                </svg>
              )}
              {groupLabel === 'Deployment' && (
                <svg class="mfc-cat-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z" />
                </svg>
              )}
              {groupLabel === 'AI & No-Backend Forms' && (
                <svg class="mfc-cat-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z" />
                </svg>
              )}

              <span class="mfc-group-title">{groupLabel}</span>
            </span>

            {/* Chevron toggle icon */}
            <svg class="mfc-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="9 18 15 12 9 6" />
            </svg>
          </summary>

          <ul class="mfc-group-list">
            {group.entries.map((item: any) => {
              const label = item.label || '';
              const active = isItemActive(item.href, label);

              return (
                <li class="mfc-item-row">
                  <a
                    href={item.href}
                    class={`mfc-sidebar-link ${active ? 'is-active' : ''}`}
                    aria-current={active ? 'page' : undefined}
                  >
                    <span class="mfc-item-icon-wrap" aria-hidden="true">
                      {/* Getting Started Icons */}
                      {label === 'Overview' && (
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                          <polyline points="9 22 9 12 15 12 15 22" />
                        </svg>
                      )}
                      {label === 'Integrating HTML Forms' && (
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <polyline points="16 18 22 12 16 6" />
                          <polyline points="8 6 2 12 8 18" />
                        </svg>
                      )}
                      {label === 'Using React SDK' && (
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <ellipse cx="12" cy="12" rx="10" ry="4.5" transform="rotate(0 12 12)" />
                          <ellipse cx="12" cy="12" rx="10" ry="4.5" transform="rotate(60 12 12)" />
                          <ellipse cx="12" cy="12" rx="10" ry="4.5" transform="rotate(120 12 12)" />
                          <circle cx="12" cy="12" r="1.5" />
                        </svg>
                      )}
                      {label === 'API Quickstart' && (
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <rect x="4" y="4" width="16" height="16" rx="2" />
                          <rect x="9" y="9" width="6" height="6" />
                          <line x1="9" y1="1" x2="9" y2="4" />
                          <line x1="15" y1="1" x2="15" y2="4" />
                          <line x1="9" y1="20" x2="9" y2="23" />
                          <line x1="15" y1="20" x2="15" y2="23" />
                          <line x1="20" y1="9" x2="23" y2="9" />
                          <line x1="20" y1="14" x2="23" y2="14" />
                          <line x1="1" y1="9" x2="4" y2="9" />
                          <line x1="1" y1="14" x2="4" y2="14" />
                        </svg>
                      )}

                      {/* Features Icons */}
                      {label === 'Domain Configuration' && (
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
