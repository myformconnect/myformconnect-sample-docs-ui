<script>
  // Mobile search trigger inside sidebar
  const mobileSearchBtn = document.getElementById("mfcSidebarMobileSearchTrigger");
  mobileSearchBtn?.addEventListener("click", (e) => {
    e.preventDefault();
    e.stopPropagation();

    if (typeof (window as any).openMfcSearchModal === "function") {
      (window as any).openMfcSearchModal(e);
      return;
    }

    // Fallback if header script has not registered yet
    const sidebar = document.getElementById("starlight__sidebar");
    if (sidebar && typeof (sidebar as any).hidePopover === "function") {
      try {
        if ((sidebar as any).matches(":popover-open")) {
          (sidebar as any).hidePopover();
        }
      } catch {}
    }

    setTimeout(() => {
      const starlightOpenBtn = document.querySelector(
        "site-search button[data-open-modal]",
      ) as HTMLButtonElement | null;
      if (starlightOpenBtn) {
        starlightOpenBtn.disabled = false;
        starlightOpenBtn.click();
      } else {
        const dialog = document.querySelector(
          "site-search dialog",
        ) as HTMLDialogElement | null;
        if (dialog && !dialog.open) {
          dialog.showModal();
          document.body.toggleAttribute("data-search-modal-open", true);
        }
      }

      setTimeout(() => {
        const input = document.querySelector("#starlight__search input") as HTMLInputElement | null;
        input?.focus();
      }, 50);
    }, 15);
  });

  // Mobile theme toggle inside sidebar
  const mobileThemeToggle = document.getElementById("mfcMobileThemeToggle");
  const mobileThemeText = document.getElementById("mfcMobileThemeText");
  const mobileThemePill = document.getElementById("mfcMobileThemePill");
  const mobileSun = document.querySelector(".mfc-sidebar-mobile-prefs .mfc-icon-sun") as HTMLElement;
  const mobileMoon = document.querySelector(".mfc-sidebar-mobile-prefs .mfc-icon-moon") as HTMLElement;
  const headerThemeToggle = document.getElementById("mfcThemeToggle");

  function syncMobileThemeUI(theme: string) {
    if (mobileThemeText) {
      mobileThemeText.textContent = theme === "dark" ? "Dark Mode" : "Light Mode";
    }
    if (mobileSun && mobileMoon) {
      mobileSun.style.display = theme === "dark" ? "none" : "block";
      mobileMoon.style.display = theme === "dark" ? "block" : "none";
    }
    if (mobileThemePill) {
      mobileThemePill.classList.toggle("is-dark", theme === "dark");
    }
  }

  // Initial sync
  const curTheme = document.documentElement.dataset.theme || localStorage.getItem("starlight-theme") || "light";
  syncMobileThemeUI(curTheme);

  // Sync on toggle click
  mobileThemeToggle?.addEventListener("click", () => {
    if (headerThemeToggle) {
      headerThemeToggle.click();
      const updated = document.documentElement.dataset.theme || "light";
      syncMobileThemeUI(updated);
    } else {
      const cur = document.documentElement.dataset.theme || "light";
      const next = cur === "dark" ? "light" : "dark";
      document.documentElement.dataset.theme = next;
      try { localStorage.setItem("starlight-theme", next); } catch {}
      syncMobileThemeUI(next);
    }
  });

  // Watch for theme changes from other sources (e.g. header button)
  const themeObserver = new MutationObserver(() => {
    const updated = document.documentElement.dataset.theme || "light";
    syncMobileThemeUI(updated);
  });
  themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });

  // Mobile language select inside sidebar
  const mobileLangSelect = document.getElementById("mfcMobileLangSelect") as HTMLSelectElement | null;
  const headerLangText = document.getElementById("mfcCurrentLangText");
  mobileLangSelect?.addEventListener("change", () => {
    const val = mobileLangSelect.value;
    if (headerLangText) {
      headerLangText.textContent = val;
    }
  });

  // Close sidebar popover when navigation links are clicked
  const navLinks = document.querySelectorAll(".mfc-sidebar-link, .mfc-help-link");
  navLinks.forEach((link) => {
    link.addEventListener("click", () => {
      const sidebar = document.getElementById("starlight__sidebar");
      if (sidebar && typeof (sidebar as any).hidePopover === "function") {
        try {
          if ((sidebar as any).matches(":popover-open")) {
            (sidebar as any).hidePopover();
          }
        } catch {}
      }
    });
  });

  // Desktop sidebar collapse / expand toggle
  const collapseToggle = document.getElementById("mfcSidebarCollapseToggle");

  function updateCollapseUI(isCollapsed: boolean) {
    if (collapseToggle) {
      collapseToggle.setAttribute("aria-expanded", String(!isCollapsed));
      collapseToggle.setAttribute(
        "title",
        isCollapsed ? "Expand sidebar" : "Collapse sidebar",
      );
    }
  }

  // Initial check
  const isCurrentlyCollapsed = document.documentElement.getAttribute("data-sidebar-collapsed") === "true";
  updateCollapseUI(isCurrentlyCollapsed);

  collapseToggle?.addEventListener("click", () => {
    const isCollapsed = document.documentElement.getAttribute("data-sidebar-collapsed") === "true";
    const nextState = !isCollapsed;

    if (nextState) {
      document.documentElement.setAttribute("data-sidebar-collapsed", "true");
      try { localStorage.setItem("mfc-sidebar-collapsed", "true"); } catch {}
    } else {
      document.documentElement.removeAttribute("data-sidebar-collapsed");
      try { localStorage.removeItem("mfc-sidebar-collapsed"); } catch {}
    }
    updateCollapseUI(nextState);

    // Dispatch resize event so Hero and dynamic elements adapt to new available width
    setTimeout(() => {
      window.dispatchEvent(new Event("resize"));
    }, 230);
  });
</script>
