              d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
            ></path>
          </svg>
          <span class="mfc-pref-title">Language</span>
        </div>
        <div class="mfc-select-wrap">
          <select
            id="mfcMobileLangSelect"
            class="mfc-mobile-select"
            aria-label="Select documentation language"
          >
            <option value="English" selected>English</option>
            <option value="Español">Español</option>
            <option value="Français">Français</option>
            <option value="Deutsch">Deutsch</option>
            <option value="Português">Português</option>
            <option value="日本語">日本語</option>
          </select>
          <svg
            class="mfc-select-chevron"
            width="12"
            height="12"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </div>
      </div>

      <!-- Theme Switcher -->
      <div class="mfc-mobile-theme-box">
        <div class="mfc-mobile-pref-header">
          <svg
            class="mfc-pref-icon mfc-icon-sun"
            width="15"
            height="15"
            viewBox="0 0 24 24"
