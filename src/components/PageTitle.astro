---
import type { Props } from '@astrojs/starlight/props';

const route = Astro.locals.starlightRoute;
const isRootPage = Astro.url.pathname === '/' || route?.slug === '' || route?.slug === 'index';
const title = Astro.locals.starlightRoute?.entry?.data?.title || '';
---

{!isRootPage && (
  <div class="mfc-doc-header">
    <a href="/" class="mfc-back-link">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="19" y1="12" x2="5" y2="12"></line>
        <polyline points="12 19 5 12 12 5"></polyline>
      </svg>
      <span>Back to documentation</span>
    </a>

    <div class="mfc-title-row">
      <h1 id="_top">{title}</h1>
      <div class="mfc-title-actions">
        <button type="button" class="mfc-doc-btn" aria-label="Copy as Markdown">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <span>Copy as Markdown</span>
        </button>

        <button type="button" class="mfc-doc-btn" aria-label="View as .md">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
          <span>View as .md</span>
        </button>
      </div>
    </div>

    <div class="mfc-doc-meta">
      <span class="mfc-update-date">Updated October 9, 2026</span>
    </div>

    <div class="mfc-doc-divider"></div>

    <div class="mfc-lang-box">
      <span class="mfc-lang-icon" aria-hidden="true">文A</span>
      <span class="mfc-lang-label">Also available in:</span>
      <span class="mfc-lang-list">
        <a href="#de" class="mfc-lang-link">Deutsch</a>,
        <a href="#es" class="mfc-lang-link">Español</a>,
        <a href="#fr" class="mfc-lang-link">Français</a>,
        <a href="#it" class="mfc-lang-link">Italiano</a>,
        <a href="#ja" class="mfc-lang-link">日本語</a>
      </span>
    </div>
  </div>
)}

<style>
  .mfc-doc-header {
    width: 100%;
    margin-bottom: 0.5rem;
  }

  .mfc-back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: #64748b;
    text-decoration: none;
    margin-bottom: 1.15rem;
    transition: color 0.15s ease;
  }

  .mfc-back-link:hover {
    color: #0f172a;
  }

  .mfc-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.45rem;
  }

  h1 {
    font-size: clamp(1.6rem, 1.5rem + 0.35vw, 1.85rem);
    font-weight: 700;
    color: #0f172a;
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin: 0;
  }

  .mfc-title-actions {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .mfc-doc-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.65rem;
    background: #ffffff;
    color: #334155;
    border: 1px solid #e2e8f0;
    border-radius: 0.375rem;
    font-size: 0.775rem;
    font-weight: 500;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.15s ease;
    user-select: none;
    white-space: nowrap;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
  }

  .mfc-doc-btn:hover {
    background: #f8fafc;
    border-color: #cbd5e1;
    color: #0f172a;
  }

  .mfc-doc-meta {
    margin-bottom: 1.15rem;
  }

  .mfc-update-date {
    font-size: 0.8125rem;
    color: #64748b;
    font-weight: 400;
  }

  .mfc-doc-divider {
    border-bottom: 1px solid #f1f5f9;
    margin-bottom: 1.15rem;
  }

  .mfc-lang-box {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.85rem;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 0.5rem;
    font-size: 0.8125rem;
    color: #334155;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
    box-sizing: border-box;
  }

  .mfc-lang-icon {
    font-size: 0.875rem;
    font-weight: 600;
    color: #64748b;
    letter-spacing: -0.02em;
    user-select: none;
    margin-right: 0.15rem;
  }

  .mfc-lang-label {
    color: #475569;
  }

  .mfc-lang-list {
    display: inline-flex;
    gap: 0.25rem;
    flex-wrap: wrap;
  }

  .mfc-lang-link {
    color: #2563eb;
    text-decoration: none;
    font-weight: 500;
    transition: color 0.15s ease, text-decoration 0.15s ease;
  }

  .mfc-lang-link:hover {
    color: #1d4ed8;
    text-decoration: underline;
  }
</style>
