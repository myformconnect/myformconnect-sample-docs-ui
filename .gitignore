# ==============================================================================
# Git Ignore for Astro / Starlight Documentation Project
# ==============================================================================

# 1. Dependencies
node_modules/
/.pnp
.pnp.*

# 2. Production Build Output
dist/

# 3. Astro Cache & Generated Files
.astro/

# 4. Vite & Bundler Cache
.cache/
.vite/
.parcel-cache/

# 5. Environment Variables & Secrets
.env
.env.*
!.env.example
!.env.template

# 6. Logs & Debug Info
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 7. TypeScript Cache
*.tsbuildinfo

# 8. Temporary Files & Local Scratchpads
tmp/
temp/
*.tmp
*.temp
scratch/
.temp/

# 9. Test & Code Coverage
coverage/
.nyc_output/

# 10. IDE & Code Editor Files
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# 11. Operating System Files
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
